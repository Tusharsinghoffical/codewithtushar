# Server Port
PORT=3000

# Environment Mode
NODE_ENV=production

# Public Canonical & Alternate Site URLs
VITE_APP_URL=https://codewithmrsingh.me
VITE_APP_SECONDARY_URL=https://codewithtushar.me

# Note: Client-side builds must NEVER inject private backend credentials or raw API keys.
